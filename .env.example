# Use a separate Auth0 application and database connection for development.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
# For a custom login domain, use the default tenant's Management API identifier.
# Example: https://your-tenant.us.auth0.com/api/v2/
AUTH0_MANAGEMENT_AUDIENCE=
# Enable email + username Flexible Identifiers on this connection; see README.
# Management API permissions: read:users create:users update:users create:user_tickets
AUTH0_CONNECTION=Username-Password-Authentication

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
APP_BASE_URL=http://localhost:3001
APP_TIMEZONE=Asia/Shanghai
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGO_DB=lesson_desk

# Local Compose captures invoices in Mailpit at http://localhost:8025.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=lessons@example.test

# Optional AI drafting. These models can be changed independently.
OPENROUTER_API_KEY=
OPENROUTER_PLAN_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FEEDBACK_MODEL=google/gemini-2.5-flash

# WebRTC calls: configure TURN for reliable connectivity through restrictive networks.
CALL_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# For coturn's shared-secret authentication (temporary per-user credentials):
CALL_TURN_URLS=
CALL_TURN_SECRET=
